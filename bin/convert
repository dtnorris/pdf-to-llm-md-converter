#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require "pathname"
require "yaml"

ROOT = Pathname.new(__dir__).join("..").expand_path
$LOAD_PATH.unshift(ROOT.join("lib").to_s)

require "apple_vision_adapter"
require "auto_adapter"
require "converter"
require "docling_adapter"
require "progress_reporter"

options = {
  config: ROOT.join("config", "conversion.yml").to_s,
  output_dir: ROOT.join("build").to_s,
  from_page: 1,
  printed_page_offset: nil,
  backend: nil
}

parser = OptionParser.new do |opts|
  opts.banner = "Usage: bin/convert INPUT.pdf [options]"

  opts.on(
    "-o",
    "--output-dir DIR",
    "Output directory (default: build)"
  ) { |value| options[:output_dir] = value }

  opts.on(
    "-c",
    "--config FILE",
    "Configuration file"
  ) { |value| options[:config] = value }

  opts.on(
    "--title TITLE",
    "Document title for front matter and output filename"
  ) { |value| options[:title] = value }

  opts.on(
    "--from PAGE",
    Integer,
    "First PDF page (default: 1)"
  ) { |value| options[:from_page] = value }

  opts.on(
    "--to PAGE",
    Integer,
    "Last PDF page (default: final page)"
  ) { |value| options[:to_page] = value }


  opts.on(
    "--backend BACKEND",
    %w[auto docling apple-vision],
    "Extraction backend: auto, docling, or apple-vision (default: config; normally auto)"
  ) { |value| options[:backend] = value }

  opts.on(
    "--printed-page-offset OFFSET",
    Integer,
    "Printed page = PDF page + OFFSET; bypass automatic printed-page detection"
  ) { |value| options[:printed_page_offset] = value }

  opts.on("-h", "--help", "Show help") do
    puts opts
    exit 0
  end
end

parser.parse!

input = ARGV.shift
abort(parser.to_s) unless input

begin
  config = YAML.safe_load_file(options[:config])
  backend = (options[:backend] || config.dig("converter", "adapter") || "auto").to_s
  adapter = case backend
  when "auto"
    PdfToLlmMd::AutoAdapter.new(config: config)
  when "docling"
    PdfToLlmMd::DoclingAdapter.new(config: config)
  when "apple-vision"
    PdfToLlmMd::AppleVisionAdapter.new(config: config).tap do |candidate|
      unless candidate.available?
        raise PdfToLlmMd::AdapterError,
              "Apple Vision backend requires macOS, xcrun, and pdftoppm"
      end
    end
  else
    raise ArgumentError, "Unknown backend: #{backend.inspect}"
  end

  reporter = PdfToLlmMd::ProgressReporter.new
  reporter.start

  result = PdfToLlmMd::Converter
    .new(config_path: options[:config], adapter: adapter)
    .convert(
      input: input,
      output_dir: options[:output_dir],
      title: options[:title],
      from_page: options[:from_page],
      to_page: options[:to_page],
      printed_page_offset: options[:printed_page_offset],
      progress: reporter
    )

  reporter.finish(output_path: result.output_path)

  quality = result.extraction_quality
  backend_counts = quality.pages.values.map { |page| page.fetch("backend") }.tally
  puts "Extraction quality: #{quality.valid ? 'PASS' : 'FAIL'} " \
       "(#{backend_counts.map { |name, count| "#{name}=#{count}" }.join(', ')})"

  quality.issues.each do |issue|
    warn "Extraction quality failure: PDF page #{issue.page} " \
         "[#{issue.backend}] #{issue.reason}"
  end

  exit(result.validation.valid && quality.valid ? 0 : 2)
rescue StandardError => error
  warn "Conversion failed: #{error.class}: #{error.message}"
  exit 1
end
